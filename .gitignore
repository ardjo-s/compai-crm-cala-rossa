# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. `.env.example` is the one that is committed — it is the
# documentation, so the catch-all below must not swallow it. The Ardjo overlay
# is non-secret and is committed too.
.env
.env.*
!.env.example
!.env.ardjo.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
/.logs/
/.local/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Agent worktrees
.claude/worktrees/

# Skills are installed to .agents/skills; .claude/skills mirrors them per-tool
.claude/skills/

# eve build output
.eve
.output
/dogfood-output

# Agent scratch files
.scratch/
